{
  "name": "streamtrack-tv-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.19",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run --filter web dev",
    "dev:docs": "bun run --filter docs dev",
    "build": "bun run build:schema && bun run --filter web build",
    "build:schema": "bun run --filter streamtrack-tv build",
    "build:docs": "bun run build:schema && bun run --filter docs build",
    "lint:package": "bun run --filter streamtrack-tv lint:package",
    "test": "bun run --filter '*' test",
    "test:coverage": "bun run --filter '*' test:coverage",
    "test:e2e": "bun run --filter web test:e2e",
    "test:pack": "bun run --filter streamtrack-tv test:pack",
    "test:android": "cd android && ./gradlew test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage",
    "sync:samples": "node scripts/samples.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
