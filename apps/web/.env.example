# StreamTrack TV web dashboard. Copy to `.env.local` for local development.
# With the Supabase variables left empty the app runs as a demo-only deployment.

# --- Supabase (set automatically by the Supabase integration on Vercel) ---

# Project URL, e.g. https://abcd1234.supabase.co. Public.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Public; row level security protects the data.
# Older projects can set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server only: used by the device API, pairing, cron jobs and account deletion.
# Older projects can set SUPABASE_SERVICE_ROLE_KEY instead. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Database migrations (run by `bun run build` before `next build`) ---

# Direct (non-pooled) Postgres connection string. The build skips migrations when neither is set.
# The Supabase integration provides POSTGRES_URL_NON_POOLING; DATABASE_URL wins when both exist.
DATABASE_URL=
POSTGRES_URL_NON_POOLING=
# Vercel preview builds skip migrations, since they usually share the production database. Set to 1 on a
# preview environment with its own database to migrate there too.
MIGRATE_ON_PREVIEW=
# PEM text of the CA that signed the database certificate (Supabase: Database settings, SSL configuration).
# With it the migration runner verifies the certificate; without it the connection is encrypted only.
DATABASE_CA_CERT=

# --- Site ---

# Public origin used in confirmation emails, share links and the weekly digest, without a trailing slash.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 to serve only the landing page and /demo, with accounts and the device API turned off.
DEMO_ONLY=

# --- Scheduled jobs ---

# Random string of at least 32 characters. Vercel Cron sends it as a bearer token; without it the
# cron endpoints refuse every call. Generate one with `openssl rand -hex 32`.
CRON_SECRET=

# --- Weekly digest email (optional) ---

# Resend API key. Without it the digest job reports itself as skipped.
RESEND_API_KEY=
# Sender address on a domain verified in Resend. Defaults to "StreamTrack TV <onboarding@resend.dev>",
# which Resend only delivers to the account owner.
DIGEST_FROM=
